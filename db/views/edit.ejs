<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
     <!-- <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script> -->
    <title>Home Page</title>
</head>
<body>
    <div class="div">
        <nav class="nav">
            <a class="nav-link" href="/read">Read Users</a>
        </nav>
        <form  class="form" action="/update/<%= user._id %>" method="POST">
            <h1 class="h1">Update User</h1>
            <input type="text" name="name" placeholder="Enter Name" value="<%= user.name %>">
            <input type="text" name="email" placeholder="Enter Email" value="<%= user.email %>">
            <input type="text" name="image" placeholder="Enter Image Url" value="<%= user.image %>">
            <input class="edit-button" type="submit" value="Update User">
        </form>
    </div>
</body>
</html>