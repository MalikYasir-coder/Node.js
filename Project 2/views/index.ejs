<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <!-- <link rel="stylesheet" href="/images/javascripts/stylesheets/style.css"> -->
    <title>Task Management App</title>
</head>
<body>
    <div class="main">
        <div class="form">
            <form action="/edit" method="POST">
                <input type="text" name="title" placeholder="Enter a task..." />
                <textarea name="body" placeholder="Enter a description..."></textarea>
                <input type="submit" value="Create Task" />
            </form>
        </div>
        <div class="tasks">
            <% if (tasks.length === 0) { %>
                <h3>No tasks available</h3>
            <% } else { %>
                <% tasks.forEach(function(task) { %>
                    <div class ="task">
                        <h3><%= task.title %></h3>
                        <p><%= task.body %></p>
                        <a href="/file/<%= task.title %>">Read More..</a>
                        <a href="/edit/<%= task.title %>">Edit</a>
                        <button type="button">Delete</button>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </div>
</body>
</html>
